generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String      @id @default(cuid())
  clerkId          String      @unique
  name             String
  email            String
  image            String?
  isAdmin          Boolean     @default(false)
  slackAccessToken String?
  slackTeamName    String?
  slackConnected   Boolean     @default(false)
  googleConnected  Boolean     @default(false)
  vertical         String?
  csManager        String?
  rhoCs            String?
  autoMatchedBook  Boolean     @default(false)
  coveringFor      String[]
  hiddenChannels   String[]
  lastLoginAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  savedItems           SavedItem[]
  adminItems           AdminItem[]
  handoffNotes         HandoffNote[]
  createdTrainings     Training[]
  trainingCompletions  TrainingCompletion[]
}

model SavedItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType String
  sourceId   String?
  title      String
  content    String
  sourceUrl  String?
  tags       String[]
  notes      String?
  isArchived Boolean  @default(false)
  savedAt    DateTime @default(now())
}

model AdminItem {
  id                String    @id @default(cuid())
  createdById       String
  createdBy         User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  title             String
  description       String
  date              DateTime
  endDate           DateTime?
  itemType          String
  category          String
  priority          String    @default("normal")
  link              String?
  isRecurring       Boolean   @default(false)
  recurrencePattern String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model CsmRoster {
  id          String       @id @default(cuid())
  csmName     String
  email       String
  manager     String
  rho         String
  region      String
  level       String
  status      String       @default("Active")
  title       String
  location    String
  team        String
  cp          String
  photoUrl    String?
  notes       String?
  lastUpdated DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  accounts      CsmAccount[]
  handoffNotes  HandoffNote[]

  @@index([email])
  @@index([csmName])
}

model CsmAccount {
  id             String     @id @default(cuid())
  csmName        String
  corporateBrand String
  cp             String
  rosterId       String?
  roster         CsmRoster? @relation(fields: [rosterId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())

  @@index([csmName])
  @@index([corporateBrand])
}

model AppTheme {
  id                 String   @id @default(cuid())
  accentColor        String   @default("#1DB954")
  cardBackground     String   @default("#181818")
  cardBorder         String   @default("#282828")
  sidebarBackground  String   @default("#000000")
  pageBackground     String   @default("#121212")
  primaryText        String   @default("#FFFFFF")
  secondaryText      String   @default("#B3B3B3")
  cardBorderRadius   Int      @default(8)
  cardSpacing        String   @default("comfortable")
  sidebarWidth       String   @default("default")
  fontSize           String   @default("medium")
  badgeStyle         String   @default("pill")
  animationsEnabled  Boolean  @default(true)
  showUrgencyColors  Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model HandoffNote {
  id        String    @id @default(cuid())
  rosterId  String
  roster    CsmRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  cpName    String
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  status    String    @default("active")
  priority  String    @default("normal")
  tags      String[]
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([rosterId])
  @@index([cpName])
  @@index([authorId])
}

model Training {
  id          String               @id @default(cuid())
  title       String
  description String               @default("")
  sourceUrl   String
  dueDate     DateTime
  assignedTo  String               @default("all")
  category    String               @default("product-training")
  isRequired  Boolean              @default(true)
  createdById String
  createdBy   User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  completions TrainingCompletion[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([dueDate])
  @@index([assignedTo])
}

model TrainingCompletion {
  id          String    @id @default(cuid())
  trainingId  String
  training    Training  @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime?
  status      String    @default("not-started")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([trainingId, userId])
  @@index([userId])
}

model QuickLink {
  id          String   @id @default(cuid())
  title       String
  url         String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
