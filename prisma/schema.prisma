generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String      @id @default(cuid())
  clerkId          String      @unique
  name             String
  email            String
  image            String?
  isAdmin          Boolean     @default(false)
  slackAccessToken String?
  slackTeamName    String?
  slackConnected   Boolean     @default(false)
  googleConnected  Boolean     @default(false)
  vertical         String?
  csManager        String?
  rhoCs            String?
  autoMatchedBook  Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  savedItems       SavedItem[]
  adminItems       AdminItem[]
}

model SavedItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType String
  sourceId   String?
  title      String
  content    String
  sourceUrl  String?
  tags       String[]
  notes      String?
  isArchived Boolean  @default(false)
  savedAt    DateTime @default(now())
}

model AdminItem {
  id                String    @id @default(cuid())
  createdById       String
  createdBy         User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  title             String
  description       String
  date              DateTime
  endDate           DateTime?
  itemType          String
  category          String
  priority          String    @default("normal")
  link              String?
  isRecurring       Boolean   @default(false)
  recurrencePattern String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model SalesAlignment {
  id              String   @id @default(cuid())
  region          String
  subregion       String
  hos             String
  docp            String
  team            String
  sellerName      String
  marketTeam      String
  location        String?
  rhoCs           String
  csManager       String
  csmName         String
  secondCsm       String?
  cpContractor    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([csmName])
  @@index([secondCsm])
}
